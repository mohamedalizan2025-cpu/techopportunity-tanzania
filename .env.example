# ------------------------------------------------------------------
# TechOpportunity Tanzania - environment variable template
#
# Copy this file to ".env.local" and fill in the real values yourself.
# ".env.local" is git-ignored and must NEVER be committed or shared.
# Only variable NAMES are documented here - no real credentials in Git.
# ------------------------------------------------------------------

# --- Supabase (Dashboard -> Project Settings -> API) ---

# Canonical deployed application origin used for authentication callbacks.
# Production example: https://techopportunity-tanzania.vercel.app
# Vercel's production URL is used automatically when this is left blank.
NEXT_PUBLIC_SITE_URL=

# Public project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key: safe to expose in the browser.
# Permissions are enforced by Row Level Security (RLS), not by hiding this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: BYPASSES Row Level Security.
# Server-side code only. Never prefix with NEXT_PUBLIC_, never commit,
# never paste into chat or issue trackers. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=
